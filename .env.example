# Google Calendar Settings
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=token.json

# Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
